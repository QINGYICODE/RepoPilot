# Local development only. Copy to .env; never commit real credentials.
# Create the isolated repopilot schema in your local MySQL first.
DB_URL=jdbc:mysql://localhost:3306/repopilot?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=repopilot
DB_PASSWORD=

# Required for `python3 scripts/dev.py agent`; backend-only mode needs no model.
# Use the provider's OpenAI-compatible base URL; never put a key in VITE_*.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=

# Public repositories accepted by the server (comma-separated owner/name).
REPOSITORY_ALLOWLIST=spring-petclinic/spring-petclinic-microservices
REPOSITORY_STORAGE_DIR=.local/repositories
GITHUB_TOKEN=
# Optional HTTP CONNECT proxy for GitHub API and JGit only (no credentials).
REPOSITORY_PROXY=
