# Local development only. Copy to .env; never commit real credentials.
# Create the isolated repopilot schema in your local MySQL first.
DB_URL=jdbc:mysql://localhost:3306/repopilot?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=repopilot
DB_PASSWORD=

# Optional. Only the explicit live-llm profile/command calls a real model.
# Use the provider's OpenAI-compatible base URL; never put a key in VITE_*.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
